# Copy to .env next to docker-compose.yml. No long-lived secret belongs here: the token is obtained by enrolling.
# LAN address of the queue API you run (the queue binds 0.0.0.0:7684). Printed by `cpu_lane.py enroll-code`.
CPU_RUNNER_API=http://<QUEUE-HOST-LAN-IP>:7684
# Single-use code (valid 1 h) from `cpu_lane.py enroll-code` on the queue host. Only needed for the FIRST start (or after
# a token rotation); the token is then stored in ./state/token and the code can be deleted from this file.
CPU_RUNNER_ENROLL_CODE=
# Fallback instead of enrolling: paste the shared token (less safe, it sits in this file)
# CPU_RUNNER_TOKEN=
# Everything below is optional: concurrency, lease and friends are pulled from the queue API (`cpu_lane.py config`);
# setting one here overrides the pulled value.
# CPU_RUNNER_CONCURRENCY=5
# required (default, fail closed) | auto | none   (never pulled remotely)
CPU_RUNNER_ISOLATION=required
CPU_RUNNER_CPUS=16
CPU_RUNNER_MEM=40g
# Fixed LAN identity (compose only; the Unraid template sets these itself)
# CPU_RUNNER_IP=10.0.12.52
# CPU_RUNNER_MAC=02:70:0A:00:0C:34
# CPU_RUNNER_NODE_OPTIONS=--max-old-space-size=6144
# CPU_RUNNER_LEASE_S=60
# CPU_RUNNER_MAX_TIMEOUT_S=3600
# CPU_RUNNER_CACHE_MAX=8
# CPU_RUNNER_RELOAD_GRACE_S=1800
# Disk use (README "Disk use"). Lane jobs = jobs with spec.setup or spec.llm. Pulled from the queue like the settings
# above (`cpu_lane.py config lane_max=1`); setting one here overrides the pulled value. Defaults shown.
# CPU_RUNNER_LANE_MAX=2             # most lane jobs at once; 0 = none on this runner
# CPU_RUNNER_MIN_FREE_GB=6          # free GB needed on /work and /cache to claim a lane job (under 2 GB: no job at all)
# CPU_RUNNER_UV_CACHE_MAX_GB=10     # a uv or npm cache over its cap is cleared whole once no job is running
# CPU_RUNNER_NPM_CACHE_MAX_GB=4
# CPU_RUNNER_NM_CACHE_MAX_GB=6      # node_modules copies: oldest evicted first (entry limit: CPU_RUNNER_CACHE_MAX)
# CPU_RUNNER_DISK_CHECK_S=120       # seconds between disk checks (at least 5); env only, never pulled
# Lane-only runner: a second runner that takes only lane jobs and leaves the plain (gate) jobs to the main runner.
# all (default) | lane; env only, never pulled; anything else stops the runner at start. It needs a queue that knows
# accept "lane": an older queue hands it plain jobs and it gives each one back, which costs that job an attempt.
# CPU_RUNNER_ACCEPT=all
