# Copy to .env. No secrets here: the token lives in ./secrets/token (see compose).
# LAN address of the queue API (ollama-queue-api.py binds 0.0.0.0:7684) -- NOT the Cloudflare-Access hostname.
CPU_RUNNER_API=http://<MAC-LAN-IP>:7684
CPU_RUNNER_CONCURRENCY=2
CPU_RUNNER_CPUS=8
CPU_RUNNER_MEM=16g
# required (default, fail closed) | auto | none
CPU_RUNNER_ISOLATION=required
CPU_RUNNER_NODE_OPTIONS=--max-old-space-size=6144
# CPU_RUNNER_LEASE_S=60
# CPU_RUNNER_MAX_TIMEOUT_S=3600
# CPU_RUNNER_CACHE_MAX=8
